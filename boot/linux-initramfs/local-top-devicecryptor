#!/bin/sh
# local-top script: prompt and map a DeviceCryptor system volume.
# Place in /etc/initramfs-tools/scripts/local-top/devicecryptor
# This host's disks were not used to try this script.

PREREQ="udev"
prereqs() { echo "$PREREQ"; }

case "$1" in
prereqs) prereqs; exit 0 ;;
esac

DC_DEVICE="${DC_SYSTEM_DEVICE:-}"
DC_MAPPER="${DC_MAPPER_NAME:-dcroot}"

if [ -z "$DC_DEVICE" ]; then
    exit 0
fi

if [ ! -x /bin/dc ]; then
    echo "DeviceCryptor: dc binary missing in initramfs" >&2
    exit 0
fi

echo "DeviceCryptor: mapping $DC_DEVICE to $DC_MAPPER"
# dc attach prompts on the console. It is already root here, so it does not call sudo.
# The master key goes to `dc helper` on a pipe, then to cryptsetup stdin.
/bin/dc attach --device "$DC_DEVICE" --mapper "$DC_MAPPER" || {
    echo "DeviceCryptor: attach failed" >&2
    exit 1
}

exit 0
