#!/bin/sh
# DeviceCryptor Linux initramfs unlock hook (scaffold).
# Install into /etc/initramfs-tools/hooks/ and scripts/local-top/
# Behavior aligned with VeraCrypt Linux system-encryption unlock flow.

PREREQ=""
prereqs() { echo "$PREREQ"; }

case "$1" in
prereqs) prereqs; exit 0 ;;
esac

. /usr/share/initramfs-tools/hook-functions

# Copy unlock helper and cryptsetup into initramfs when present.
if [ -x /usr/bin/dc ]; then
    copy_exec /usr/bin/dc /bin
fi
if [ -x /usr/sbin/cryptsetup ]; then
    copy_exec /usr/sbin/cryptsetup /sbin
elif [ -x /sbin/cryptsetup ]; then
    copy_exec /sbin/cryptsetup /sbin
fi

exit 0
